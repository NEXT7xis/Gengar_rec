          package com.gengar.rec

          import android.annotation.SuppressLint
          import android.app.Notification
          import android.app.NotificationChannel
          import android.app.NotificationManager
          import android.app.PendingIntent
          import android.app.Service
          import android.content.ContentValues
          import android.content.Context
          import android.content.Intent
          import android.content.pm.PackageManager
          import android.content.pm.ServiceInfo
          import android.hardware.display.DisplayManager
          import android.hardware.display.VirtualDisplay
          import android.media.AudioAttributes
          import android.media.AudioFormat
          import android.media.AudioPlaybackCaptureConfiguration
          import android.media.AudioRecord
          import android.media.MediaCodec
          import android.media.MediaCodecInfo
          import android.media.MediaFormat
          import android.media.MediaMuxer
          import android.media.MediaRecorder
          import android.media.projection.MediaProjection
          import android.media.projection.MediaProjectionManager
          import android.net.Uri
          import android.os.Build
          import android.os.Handler
          import android.os.IBinder
          import android.os.Looper
          import android.os.ParcelFileDescriptor
          import android.provider.MediaStore
          import android.util.DisplayMetrics
          import android.view.Display
          import android.view.Surface
          import android.widget.Toast
          import java.nio.ByteBuffer
          import java.text.SimpleDateFormat
          import java.util.Date
          import java.util.Locale
          import kotlin.math.min
          import kotlin.math.roundToInt

          /** Junta video + audio num MP4. Guarda amostras ate todas as trilhas existirem. */
          private class Mux(fd: java.io.FileDescriptor, private val expectAudio: Boolean) {
              private val m = MediaMuxer(fd, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
              @Volatile var vTrack = -1
              @Volatile var aTrack = -1
              @Volatile var started = false
              private class Pending(val track: Int, val data: ByteArray, val info: MediaCodec.BufferInfo)
              private val pending = ArrayList<Pending>()

              @Synchronized fun addVideo(f: MediaFormat) { vTrack = m.addTrack(f); tryStart() }
              @Synchronized fun addAudio(f: MediaFormat) { aTrack = m.addTrack(f); tryStart() }

              private fun tryStart() {
                  if (started) return
                  if (vTrack >= 0 && (!expectAudio || aTrack >= 0)) {
                      m.start()
                      started = true
                      for (p in pending) m.writeSampleData(p.track, ByteBuffer.wrap(p.data), p.info)
                      pending.clear()
                  }
              }

              @Synchronized fun write(track: Int, buf: ByteBuffer, info: MediaCodec.BufferInfo) {
                  if (track < 0 || info.size <= 0) return
                  if (started) {
                      m.writeSampleData(track, buf, info)
                  } else {
                      val arr = ByteArray(info.size)
                      buf.get(arr, 0, info.size)
                      val bi = MediaCodec.BufferInfo()
                      bi.set(0, info.size, info.presentationTimeUs, info.flags)
                      pending.add(Pending(track, arr, bi))
                  }
              }

              @Synchronized fun stop() {
                  try { if (started) m.stop() } catch (_: Exception) {}
                  try { m.release() } catch (_: Exception) {}
              }
          }

          class RecorderService : Service() {
              companion object {
                  const val ACTION_START = "start"
                  const val ACTION_STOP = "stop"
                  private const val CH = "gengar_rec"
                  private const val SR = 44100
              }

              private var projection: MediaProjection? = null
              private var vd: VirtualDisplay? = null
              private var vEnc: MediaCodec? = null
              private var aEnc: MediaCodec? = null
              private var inSurface: Surface? = null
              private var gameRec: AudioRecord? = null
              private var micRec: AudioRecord? = null
              private var mux: Mux? = null
              private var vThread: Thread? = null
              private var aThread: Thread? = null
              private var pfd: ParcelFileDescriptor? = null
              private var uri: Uri? = null
              @Volatile private var recording = false
              private var baseUs = 0L
              private val handler = Handler(Looper.getMainLooper())
              private var pendingStart: Runnable? = null

              override fun onBind(i: Intent?): IBinder? = null

              private fun cfg(k: String, d: String) =
                  getSharedPreferences("cfg", Context.MODE_PRIVATE).getString(k, d) ?: d

              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  when (intent?.action) {
                      ACTION_STOP -> { stopRecording(); stopSelf() }
                      ACTION_START -> {
                          val code = intent.getIntExtra("code", 0)
                          @Suppress("DEPRECATION")
                          val data: Intent? = if (Build.VERSION.SDK_INT >= 33)
                              intent.getParcelableExtra("data", Intent::class.java) else intent.getParcelableExtra("data")
                          val mode = cfg("audio", "game")
                          val permOk = checkSelfPermission(android.Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
                          val audioOn = mode != "none" && permOk
                          val wantGame = audioOn && (mode == "game" || mode == "both")
                          val wantMic = audioOn && (mode == "mic" || mode == "both")
                          val delay = cfg("delay", "3").toInt()
                          goForeground(if (delay > 0) "Começa em ${delay}s…" else "Gravando…", audioOn)
                          if (data == null) { stopSelf(); return START_NOT_STICKY }
                          val run = Runnable { startRecording(code, data, audioOn, wantGame, wantMic) }
                          pendingStart = run
                          handler.postDelayed(run, delay * 1000L)
                      }
                  }
                  return START_NOT_STICKY
              }

              private fun goForeground(text: String, audio: Boolean) {
                  val nm = getSystemService(NotificationManager::class.java)
                  nm.createNotificationChannel(NotificationChannel(CH, "Gravação", NotificationManager.IMPORTANCE_LOW))
                  val stop = PendingIntent.getService(
                      this, 0, Intent(this, RecorderService::class.java).setAction(ACTION_STOP),
                      PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
                  )
                  val n = Notification.Builder(this, CH)
                      .setContentTitle("Gengar Rec")
                      .setContentText(text)
                      .setSmallIcon(android.R.drawable.presence_video_online)
                      .setOngoing(true)
                      .addAction(Notification.Action.Builder(null, "PARAR", stop).build())
                      .build()
                  var type = ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION
                  if (audio && Build.VERSION.SDK_INT >= 30) type = type or ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE
                  startForeground(1, n, type)
              }

              private fun a16(v: Float) = ((v / 16f).roundToInt() * 16).coerceAtLeast(16)

              @SuppressLint("MissingPermission")
              private fun buildGameRec(p: MediaProjection): AudioRecord {
                  val c = AudioPlaybackCaptureConfiguration.Builder(p)
                      .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
                      .addMatchingUsage(AudioAttributes.USAGE_GAME)
                      .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
                      .build()
                  val f = AudioFormat.Builder()
                      .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                      .setSampleRate(SR)
                      .setChannelMask(AudioFormat.CHANNEL_IN_STEREO)
                      .build()
                  return AudioRecord.Builder()
                      .setAudioFormat(f)
                      .setBufferSizeInBytes(16384)
                      .setAudioPlaybackCaptureConfig(c)
                      .build()
              }

              @SuppressLint("MissingPermission")
              private fun buildMicRec(): AudioRecord {
                  val min = AudioRecord.getMinBufferSize(SR, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
                  return AudioRecord(
                      MediaRecorder.AudioSource.MIC, SR, AudioFormat.CHANNEL_IN_MONO,
                      AudioFormat.ENCODING_PCM_16BIT, maxOf(min, 8192)
                  )
              }

              private fun startRecording(code: Int, data: Intent, audioOn: Boolean, wantGame: Boolean, wantMic: Boolean) {
                  try {
                      val target = cfg("res", "540").toInt()
                      val fps = cfg("fps", "60").toInt()
                      val mbps = cfg("mbps", "4").toInt()
                      val hevc = cfg("codec", "h264") == "hevc"

                      val dm = DisplayMetrics()
                      @Suppress("DEPRECATION")
                      (getSystemService(DISPLAY_SERVICE) as DisplayManager)
                          .getDisplay(Display.DEFAULT_DISPLAY).getRealMetrics(dm)
                      val scale = min(1f, target.toFloat() / min(dm.widthPixels, dm.heightPixels))
                      val w = a16(dm.widthPixels * scale)
                      val h = a16(dm.heightPixels * scale)

                      val name = "Gengar_" + SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(Date()) + ".mp4"
                      val cv = ContentValues().apply {
                          put(MediaStore.Video.Media.DISPLAY_NAME, name)
                          put(MediaStore.Video.Media.MIME_TYPE, "video/mp4")
                          put(MediaStore.Video.Media.RELATIVE_PATH, "Movies/GengarRec")
                          put(MediaStore.Video.Media.IS_PENDING, 1)
                      }
                      uri = contentResolver.insert(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, cv)
                      pfd = contentResolver.openFileDescriptor(uri!!, "rw")
                      val mx = Mux(pfd!!.fileDescriptor, audioOn)
                      mux = mx

                      val mpm = getSystemService(MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
                      val proj = mpm.getMediaProjection(code, data)
                      projection = proj
                      proj.registerCallback(object : MediaProjection.Callback() {
                          override fun onStop() { handler.post { stopRecording(); stopSelf() } }
                      }, handler)

                      if (audioOn) {
                          if (wantGame) gameRec = buildGameRec(proj)
                          if (wantMic) micRec = buildMicRec()
                          val af = MediaFormat.createAudioFormat(MediaFormat.MIMETYPE_AUDIO_AAC, SR, 2).apply {
                              setInteger(MediaFormat.KEY_AAC_PROFILE, MediaCodecInfo.CodecProfileLevel.AACObjectLC)
                              setInteger(MediaFormat.KEY_BIT_RATE, 128_000)
                              setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, 16384)
                          }
                          val ae = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_AUDIO_AAC)
                          ae.configure(af, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
                          ae.start()
                          aEnc = ae
                      }

                      val mime = if (hevc) MediaFormat.MIMETYPE_VIDEO_HEVC else MediaFormat.MIMETYPE_VIDEO_AVC
                      val vf = MediaFormat.createVideoFormat(mime, w, h).apply {
                          setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface)
                          setInteger(MediaFormat.KEY_BIT_RATE, mbps * 1_000_000)
                          setInteger(MediaFormat.KEY_FRAME_RATE, fps)
                          setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 2)
                      }
                      val ve = MediaCodec.createEncoderByType(mime)
                      ve.configure(vf, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
                      val surface = ve.createInputSurface()
                      ve.start()
                      vEnc = ve
                      inSurface = surface

                      vd = proj.createVirtualDisplay(
                          "gengar", w, h, dm.densityDpi,
                          DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR, surface, null, null
                      )

                      baseUs = System.nanoTime() / 1000
                      recording = true
                      vThread = Thread({ drainVideo() }, "gengar-video").also { it.start() }
                      if (audioOn) aThread = Thread({ audioLoop() }, "gengar-audio").also { it.start() }

                      val aTxt = when { wantGame && wantMic -> "jogo+mic"; wantGame -> "áudio do jogo"; wantMic -> "mic"; else -> "sem áudio" }
                      goForeground("Gravando ${w}x${h} · ${fps}fps · $aTxt", audioOn)
                  } catch (e: Exception) {
                      Toast.makeText(this, "Erro ao gravar: ${e.message}", Toast.LENGTH_LONG).show()
                      recording = false
                      cleanup(false)
                      stopSelf()
                  }
              }

              private fun drainVideo() {
                  val enc = vEnc ?: return
                  val mx = mux ?: return
                  val info = MediaCodec.BufferInfo()
                  var firstPts = -1L
                  var offset = 0L
                  var last = -1L
                  try {
                      while (true) {
                          val i = enc.dequeueOutputBuffer(info, 10_000)
                          if (i == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) { mx.addVideo(enc.outputFormat); continue }
                          if (i < 0) continue
                          val buf = enc.getOutputBuffer(i)
                          if (buf != null && info.size > 0 && (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG) == 0) {
                              if (firstPts < 0) {
                                  firstPts = info.presentationTimeUs
                                  offset = System.nanoTime() / 1000 - baseUs
                              }
                              var pts = info.presentationTimeUs - firstPts + offset
                              if (pts <= last) pts = last + 1
                              last = pts
                              info.presentationTimeUs = pts
                              buf.position(info.offset)
                              buf.limit(info.offset + info.size)
                              mx.write(mx.vTrack, buf, info)
                          }
                          enc.releaseOutputBuffer(i, false)
                          if ((info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) break
                      }
                  } catch (_: Exception) {}
              }

              private fun s16(b: ByteArray, i: Int): Int = ((b[i + 1].toInt() shl 8) or (b[i].toInt() and 0xFF)).toShort().toInt()

              private fun put16(b: ByteArray, i: Int, v: Int) {
                  val c = v.coerceIn(-32768, 32767)
                  b[i] = (c and 0xFF).toByte()
                  b[i + 1] = ((c shr 8) and 0xFF).toByte()
              }

              private fun drainAudio(enc: MediaCodec, mx: Mux, info: MediaCodec.BufferInfo): Boolean {
                  while (true) {
                      val i = enc.dequeueOutputBuffer(info, 0)
                      if (i == MediaCodec.INFO_TRY_AGAIN_LATER) return false
                      if (i == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) { mx.addAudio(enc.outputFormat); continue }
                      if (i < 0) continue
                      val buf = enc.getOutputBuffer(i)
                      if (buf != null && info.size > 0 && (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG) == 0) {
                          buf.position(info.offset)
                          buf.limit(info.offset + info.size)
                          mx.write(mx.aTrack, buf, info)
                      }
                      enc.releaseOutputBuffer(i, false)
                      if ((info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) return true
                  }
              }

              private fun audioLoop() {
                  android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_URGENT_AUDIO)
                  val enc = aEnc ?: return
                  val mx = mux ?: return
                  val game = gameRec
                  val mic = micRec
                  val info = MediaCodec.BufferInfo()
                  val a = ByteArray(4096)
                  val m = ByteArray(2048)
                  var frames = 0L
                  var aBase = -1L
                  var lastPts = -1L
                  try {
                      game?.startRecording()
                      mic?.startRecording()
                      while (recording) {
                          var n: Int
                          if (game != null) {
                              n = game.read(a, 0, a.size)
                              if (n <= 0) continue
                              if (mic != null) {
                                  val k = mic.read(m, 0, min(m.size, n / 2))
                                  if (k > 0) {
                                      val cnt = min(k / 2, n / 4)
                                      for (j in 0 until cnt) {
                                          val mv = s16(m, 2 * j)
                                          put16(a, 4 * j, s16(a, 4 * j) + mv)
                                          put16(a, 4 * j + 2, s16(a, 4 * j + 2) + mv)
                                      }
                                  }
                              }
                          } else {
                              val k = mic!!.read(m, 0, m.size)
                              if (k <= 0) continue
                              val cnt = k / 2
                              for (j in 0 until cnt) {
                                  a[4 * j] = m[2 * j]; a[4 * j + 1] = m[2 * j + 1]
                                  a[4 * j + 2] = m[2 * j]; a[4 * j + 3] = m[2 * j + 1]
                              }
                              n = cnt * 4
                          }
                          if (aBase < 0) aBase = (System.nanoTime() / 1000 - baseUs) - (n / 4) * 1_000_000L / SR
                          var off = 0
                          while (off < n && recording) {
                              val idx = enc.dequeueInputBuffer(10_000)
                              if (idx >= 0) {
                                  val ib = enc.getInputBuffer(idx) ?: continue
                                  ib.clear()
                                  val len = min(ib.remaining(), n - off)
                                  ib.put(a, off, len)
                                  var pts = aBase + frames * 1_000_000L / SR
                                  if (pts <= lastPts) pts = lastPts + 1
                                  lastPts = pts
                                  enc.queueInputBuffer(idx, 0, len, pts, 0)
                                  off += len
                                  frames += (len / 4).toLong()
                              }
                              drainAudio(enc, mx, info)
                          }
                      }
                      // fim: manda EOS e esvazia o encoder
                      var idx = -1
                      var tries = 0
                      while (idx < 0 && tries < 50) { idx = enc.dequeueInputBuffer(10_000); tries++ }
                      if (idx >= 0) enc.queueInputBuffer(idx, 0, 0, lastPts + 1000, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                      var t = 0
                      while (t < 100 && !drainAudio(enc, mx, info)) { t++; Thread.sleep(10) }
                  } catch (_: Exception) {}
              }

              private fun stopRecording() {
                  pendingStart?.let { handler.removeCallbacks(it) }
                  pendingStart = null
                  val was = recording
                  recording = false
                  if (was) {
                      try { vEnc?.signalEndOfInputStream() } catch (_: Exception) {}
                      try { aThread?.join(3000) } catch (_: Exception) {}
                      try { vThread?.join(3000) } catch (_: Exception) {}
                  }
                  val ok = was && (mux?.started == true)
                  cleanup(ok)
                  if (ok) Toast.makeText(this, "Salvo em Filmes/GengarRec", Toast.LENGTH_LONG).show()
              }

              private fun cleanup(ok: Boolean) {
                  try { vd?.release() } catch (_: Exception) {}
                  try { vEnc?.stop() } catch (_: Exception) {}
                  try { vEnc?.release() } catch (_: Exception) {}
                  try { inSurface?.release() } catch (_: Exception) {}
                  try { aEnc?.stop() } catch (_: Exception) {}
                  try { aEnc?.release() } catch (_: Exception) {}
                  try { gameRec?.stop() } catch (_: Exception) {}
                  try { gameRec?.release() } catch (_: Exception) {}
                  try { micRec?.stop() } catch (_: Exception) {}
                  try { micRec?.release() } catch (_: Exception) {}
                  try { mux?.stop() } catch (_: Exception) {}
                  try { projection?.stop() } catch (_: Exception) {}
                  try { pfd?.close() } catch (_: Exception) {}
                  uri?.let {
                      try {
                          if (ok) contentResolver.update(it, ContentValues().apply {
                              put(MediaStore.Video.Media.IS_PENDING, 0)
                          }, null, null) else contentResolver.delete(it, null, null)
                      } catch (_: Exception) {}
                  }
                  vd = null; vEnc = null; aEnc = null; inSurface = null
                  gameRec = null; micRec = null; mux = null
                  projection = null; pfd = null; uri = null
                  vThread = null; aThread = null
              }

              override fun onDestroy() { stopRecording(); super.onDestroy() }
          }
          EOF_7
