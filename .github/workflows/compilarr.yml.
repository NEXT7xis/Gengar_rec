          import android.view.Gravity
          import android.view.ViewGroup.LayoutParams.MATCH_PARENT
          import android.view.ViewGroup.LayoutParams.WRAP_CONTENT
          import android.widget.ImageView
          import android.widget.LinearLayout
          import android.widget.ScrollView
          import android.widget.TextView
          import android.widget.Toast

          class MainActivity : Activity() {
              private val CARD = Color.parseColor("#0C0812")
              private val STROKE = Color.parseColor("#3B1F52")
              private val PURPLE = Color.parseColor("#9B4BC4")
              private val PINK = Color.parseColor("#D45FE0")
              private val CHIP = Color.parseColor("#1A1224")
              private val MUTED = Color.parseColor("#9A86A8")
              private val DEF = mapOf(
                  "res" to "540", "fps" to "60", "mbps" to "4",
                  "codec" to "h264", "audio" to "game", "delay" to "3"
              )
              private lateinit var sp: SharedPreferences
              private val refreshers = mutableListOf<() -> Unit>()

              private fun get(k: String) = sp.getString(k, DEF[k]) ?: DEF[k]!!
              private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
              private fun refreshAll() = refreshers.forEach { it() }

              private fun shape(fill: Int, r: Int = 12, stroke: Int = 0) = GradientDrawable().apply {
                  setColor(fill)
                  cornerRadius = dp(r).toFloat()
                  if (stroke != 0) setStroke(dp(1), stroke)
              }

              private fun text(t: String, size: Float, color: Int, bold: Boolean = false) = TextView(this).apply {
                  text = t; textSize = size; setTextColor(color)
                  if (bold) typeface = Typeface.DEFAULT_BOLD
              }

              private fun card(root: LinearLayout, title: String): LinearLayout {
                  val c = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      background = shape(CARD, 16, STROKE)
                      setPadding(dp(14), dp(12), dp(14), dp(14))
                      layoutParams = LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT).apply { topMargin = dp(12) }
                  }
                  c.addView(text(title, 11f, PINK, true).apply {
                      letterSpacing = 0.12f; setPadding(0, 0, 0, dp(8))
                  })
                  root.addView(c)
                  return c
              }

              private fun segmented(card: LinearLayout, key: String, labels: List<String>, values: List<String>) {
                  val row = LinearLayout(this)
                  val tvs = labels.mapIndexed { i, l ->
                      text(l, 13f, MUTED, true).apply {
                          gravity = Gravity.CENTER
                          setPadding(dp(2), dp(11), dp(2), dp(11))
                          layoutParams = LinearLayout.LayoutParams(0, WRAP_CONTENT, 1f).apply { setMargins(dp(3), 0, dp(3), 0) }
                          setOnClickListener { sp.edit().putString(key, values[i]).apply(); refreshAll() }
                      }
                  }
                  tvs.forEach { row.addView(it) }
                  card.addView(row)
                  refreshers += {
                      tvs.forEachIndexed { i, t ->
                          val on = get(key) == values[i]
                          t.background = shape(if (on) PURPLE else CHIP, 10)
                          t.setTextColor(if (on) Color.WHITE else MUTED)
                      }
                  }
              }

